# ============================================================================
# NOCTRA STORE — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values. NEVER commit .env.
# ============================================================================

# --- App ---
NODE_ENV=development
PORT=3000
STORE_NAME="Noctra Store"
STORE_CURRENCY=IDR
STORE_TIMEZONE=Asia/Jakarta

# --- Database ---
# Example (local): postgresql://postgres:postgres@localhost:5432/noctra_store
DATABASE_URL=

# --- WhatsApp Cloud API (Meta) ---
# Get these from https://developers.facebook.com/apps -> your app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose. Meta will send this back during webhook verification (GET /webhooks/whatsapp).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0

# --- Payment (used starting Phase 4) ---
PAYMENT_API_KEY=
WEBHOOK_SECRET=

# --- Admin (used starting Phase 6) ---
ADMIN_SECRET=

# --- Redis (optional, used starting later phases for session/queue) ---
REDIS_URL=
